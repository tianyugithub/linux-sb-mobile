# 依赖与构建产物
node_modules/
dist/
.expo/
.expo-shared/
web-build/

# 原生构建产物（modules/ 下各原生模块的 build 之前漏了，会进 4.9MB dex）
android/app/build/
android/build/
android/.gradle/
**/.gradle/
modules/**/build/
*.hbc
*.apk
*.aab

# 本地会话数据：里面是真实登录 cookie（bbs_auth / refresh token），绝对不能提交
.data/

# wrangler / miniflare 本地开发状态（含本地 R2 桶数据、缓存），只是本机调试产物
.wrangler/
**/.wrangler/

# 签名：保留 RN 模板自带的 debug.keystore，正式签名文件与凭据一律不进仓库
android/keystore.properties
*.jks
*.keystore
!android/app/debug.keystore

# 只留纯代码：设计源图与文档不入库（本机保留）
art-source/
docs/

# 本机 AI 代理规则文件（只在本机用，不进仓库）
AGENTS.md

# 系统 / 编辑器垃圾
.DS_Store
*.orig.*
npm-debug.*
yarn-error.*
.idea/
