  "dependencies": {
    "@nutui/nutui-react-native": "0.0.8",
    "@react-native-cookies/cookies": "^6.2.1",
    "expo": "^54.0.37",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-file-system": "~19.0.24",
