    "export:web": "EXPO_PUBLIC_API_URL=same-origin expo export --platform web",
    "typecheck": "tsc --noEmit",
    "build:editor": "node scripts/build-editor.mjs",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "check:hooks": "npx tsx scripts/check-hooks-order.ts",
    "check:cache": "node scripts/check-query-cache.mjs",
    "check:stamp": "npx tsx scripts/check-topic-stamp.ts",
    "check:kernel": "node scripts/check-kernel-build.mjs",
    "check:drift": "node scripts/run-stubbed.mjs scripts/check-official-drift.ts",
    "check:filter": "node scripts/run-stubbed.mjs scripts/check-topic-filter.ts",
    "check:checkin": "node scripts/run-stubbed.mjs scripts/check-checkin.ts",
    "check:hot": "node scripts/run-stubbed.mjs scripts/check-hot-topics.ts",
    "check:update": "node scripts/run-stubbed.mjs scripts/check-update.ts",
    "check:access": "npx tsx scripts/check-access.ts",
